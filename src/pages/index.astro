---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogCard from '../components/BlogCard.astro';
import { SITE } from '../data/site';
import { getFeaturedProjects } from '../data/projects';
import { getPublishedPosts } from '../utils/blog';

const featuredProjects = getFeaturedProjects();
const posts = await getPublishedPosts();
const latestPosts = posts.slice(0, 3);
---

<BaseLayout>
  <div class="mx-auto max-w-[960px] px-6 py-20">
    <section class="max-w-[680px]">
      <p class="text-sm text-[var(--color-muted)]">{SITE.role}</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">
        Ship software that scales.
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-[var(--color-muted)]">
        {SITE.bio}
      </p>
      <div class="mt-8 flex gap-4">
        <a
          href="/projects"
          class="border border-[var(--color-ink)] px-5 py-2.5 text-sm font-medium transition-colors hover:bg-[var(--color-ink)] hover:text-[var(--color-surface)]"
        >
          View projects
        </a>
        <a
          href="/contact"
          class="border border-[var(--color-border)] px-5 py-2.5 text-sm text-[var(--color-muted)] transition-colors hover:border-[var(--color-ink)] hover:text-[var(--color-ink)]"
        >
          Get in touch
        </a>
      </div>
    </section>

    <section class="mt-24">
      <div class="flex items-baseline justify-between border-b border-[var(--color-border)] pb-4">
        <h2 class="text-sm font-medium uppercase tracking-wider text-[var(--color-muted)]">
          Selected work
        </h2>
        <a href="/projects" class="text-sm text-[var(--color-muted)] hover:text-[var(--color-ink)]">
          View all →
        </a>
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {featuredProjects.map((project) => <ProjectCard project={project} featured />)}
      </div>
    </section>

    {
      latestPosts.length > 0 && (
        <section class="mt-24">
          <div class="flex items-baseline justify-between border-b border-[var(--color-border)] pb-4">
            <h2 class="text-sm font-medium uppercase tracking-wider text-[var(--color-muted)]">
              Latest writing
            </h2>
            <a href="/blog" class="text-sm text-[var(--color-muted)] hover:text-[var(--color-ink)]">
              View all →
            </a>
          </div>
          <div class="mt-2">
            {latestPosts.map((post) => (
              <BlogCard post={post} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
