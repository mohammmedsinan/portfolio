---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

const skills = {
  'Back-End': [
    'NestJS',
    'TypeScript',
    'Node.js',
    'MySQL',
    'PostgreSQL',
    'TypeORM',
    'Redis',
    'REST',
    'Swagger/OpenAPI',
    'Cron jobs',
    'Multi-tenant RBAC',
    'i18n (en/ar)',
  ],
  'Auth & Payments': ['JWT/OAuth2', 'Passport', 'Stripe'],
  'APIs & AI': [
    'Google Cloud Storage',
    'GBP APIs',
    'Google Ads API',
    'Deepseek/OpenAI SDK',
  ],
  'DevOps & Tools': [
    'Docker',
    'Jest',
    'Biome',
    'Railway',
    'Bitbucket Pipelines',
    'DigitalOcean',
  ],
};

const experience = [
  {
    title: 'Full-Stack Developer',
    company: 'LocalEyesAi · Canada (Remote)',
    period: 'Jun 2026 – Present',
    summary:
      'Sole backend engineer on a NestJS / TypeScript SaaS API for local SEO — GBP sync, ranking, billing, and AI audits.',
  },
  {
    title: 'Full-Stack Developer',
    company: 'KooraKings · Optimiza.ca · Kitchener, Canada (Remote)',
    period: 'Jun 2021 – Present',
    summary:
      'Built and scaled the Node.js / Sails.js backend for Koora Kings, supporting 80K+ users, 1K+ contests, and 2M+ predictions via ~180 REST APIs.',
  },
  {
    title: 'Front-End Developer',
    company: 'Riyadh Season (Contract) · Optimiza.ca · Kitchener, Canada (Remote)',
    period: 'Jun 2021 – Present',
    summary:
      'Managed API operations for a 30-page web platform fully integrated with an internally developed CMS; modernized frontend integration and improved performance by 24%.',
  },
];

const education = [
  {
    title: "Bachelor's in Business Administration",
    org: 'University of Tikrit',
    period: 'Mar 2022 – Aug 2026',
  },
];

const certifications = [
  {
    title: 'Software Engineer',
    org: 'HackerRank',
    period: 'Mar 2025',
    url: 'https://www.hackerrank.com/certificates/82d47e7b38f5',
  },
  {
    title: 'JS / Algorithms and Data Structures',
    org: 'freeCodeCamp',
    period: 'Mar 2025',
    url: 'https://freecodecamp.org/certification/fcc3c73bf9b-a6f3-4c4b-b4e0-173354fc95ad/javascript-algorithms-and-data-structures-v8',
  },
];
---

<BaseLayout title="About" description={`About ${SITE.name} · ${SITE.role}`}>
  <div class="mx-auto max-w-[680px] px-6 py-16">
    <h1 class="text-3xl font-semibold tracking-tight">About</h1>
    <div class="mt-8 space-y-5 text-[1.0625rem] leading-relaxed text-[var(--color-muted)]">
      <p>{SITE.bio}</p>
      {SITE.bioExtended.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <div class="mt-8 flex flex-wrap gap-4">
      <a
        href={SITE.cv}
        target="_blank"
        rel="noopener noreferrer"
        class="border border-[var(--color-ink)] px-5 py-2.5 text-sm font-medium transition-colors hover:bg-[var(--color-ink)] hover:text-[var(--color-surface)]"
      >
        Preview CV
      </a>
      <a
        href={SITE.cv}
        download="Mohammed-Sinan-CV.pdf"
        class="border border-[var(--color-border)] px-5 py-2.5 text-sm text-[var(--color-muted)] transition-colors hover:border-[var(--color-ink)] hover:text-[var(--color-ink)]"
      >
        Download CV
      </a>
    </div>

    <section class="mt-16">
      <h2 class="text-sm font-medium uppercase tracking-wider text-[var(--color-muted)]">
        Experience
      </h2>
      <div class="mt-6 space-y-8">
        {
          experience.map((job) => (
            <div class="border-b border-[var(--color-border)] pb-8 last:border-b-0">
              <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                <h3 class="font-medium">{job.title}</h3>
                <span class="text-sm text-[var(--color-muted)]">{job.period}</span>
              </div>
              <p class="mt-1 text-sm text-[var(--color-muted)]">{job.company}</p>
              <p class="mt-3 text-sm leading-relaxed text-[var(--color-muted)]">{job.summary}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-16">
      <h2 class="text-sm font-medium uppercase tracking-wider text-[var(--color-muted)]">
        Skills
      </h2>
      <div class="mt-6 grid gap-8 sm:grid-cols-2">
        {
          Object.entries(skills).map(([category, items]) => (
            <div>
              <h3 class="text-sm font-medium">{category}</h3>
              <ul class="mt-3 flex flex-wrap gap-2">
                {items.map((skill) => (
                  <li class="rounded-full border border-[var(--color-border)] px-2.5 py-0.5 text-xs text-[var(--color-muted)]">
                    {skill}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-16">
      <h2 class="text-sm font-medium uppercase tracking-wider text-[var(--color-muted)]">
        Education
      </h2>
      <div class="mt-6 space-y-6">
        {
          education.map((item) => (
            <div class="border-b border-[var(--color-border)] pb-6 last:border-b-0">
              <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                <h3 class="font-medium">{item.title}</h3>
                <span class="text-sm text-[var(--color-muted)]">{item.period}</span>
              </div>
              <p class="mt-1 text-sm text-[var(--color-muted)]">{item.org}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-16">
      <h2 class="text-sm font-medium uppercase tracking-wider text-[var(--color-muted)]">
        Certifications
      </h2>
      <div class="mt-6 space-y-6">
        {
          certifications.map((item) => (
            <div class="border-b border-[var(--color-border)] pb-6 last:border-b-0">
              <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                <h3 class="font-medium">
                  <a
                    href={item.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline-offset-4 hover:underline"
                  >
                    {item.title} ↗
                  </a>
                </h3>
                <span class="text-sm text-[var(--color-muted)]">{item.period}</span>
              </div>
              <p class="mt-1 text-sm text-[var(--color-muted)]">{item.org}</p>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
