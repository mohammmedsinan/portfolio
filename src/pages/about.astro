---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

const skills = {
  Languages: ['TypeScript', 'JavaScript', 'Python', 'SQL'],
  Backend: [
    'Node.js',
    'NestJS',
    'Express.js',
    'Sails.js',
    'REST APIs',
  ],
  Frontend: [
    'React',
    'Next.js',
    'Astro',
    'Tailwind CSS',
    'Ant Design',
    'Redux Toolkit',
    'React Router',
    'TanStack Query',
  ],
  'Databases & Data': [
    'MySQL',
    'MariaDB',
    'MongoDB',
    'Supabase',
    'TypeORM',
    'Prisma',
    'Drizzle',
    'Waterline',
  ],
  'Infrastructure & Architecture': [
    'Redis / Valkey',
    'BullMQ',
    'Firebase',
    'Multi-Tenant SaaS',
    'RBAC',
    'OAuth 2.0',
    'Webhooks',
  ],
  'Cloud & DevOps': [
    'Docker',
    'AWS',
    'GCP',
    'DigitalOcean',
    'GitHub Actions',
    'Bitbucket Pipelines',
    'CI/CD',
  ],
  'Tools & Testing': ['Git', 'Jest', 'Vite', 'Webpack', 'Babel'],
};

const experience = [
  {
    title: 'Full-Stack Developer / Lead Backend Engineer',
    company: 'LocalEyes AI · Remote',
    period: 'Jun 2026 – Present',
    summary:
      'Architected and developed a multi-tenant NestJS SaaS backend with secure tenant isolation, Google Business Profile synchronization, BullMQ workers, geo-grid rank tracking, AI audits, Stripe billing, and DigitalOcean deployments.',
  },
  {
    title: 'Full-Stack Developer',
    company: 'KooraKings · Optimiza · Remote',
    period: 'Jun 2021 – Present',
    summary:
      'Built and maintained the Sails.js backend powering sports contests and 2M+ user predictions across approximately 180 REST endpoints, including prediction workflows, fantasy systems, live data synchronization, and administrative APIs.',
  },
  {
    title: 'Front-End Developer',
    company: 'Riyadh Season · Optimiza · Contract · Remote',
    period: 'Jun 2021 – Present',
    summary:
      'Developed and maintained a 30+ page CMS-integrated production platform, improving performance by approximately 24%, modernizing frontend architecture, and reducing the deployment pipeline to approximately 34 seconds.',
  },
];

const education = [
  {
    title: 'Bachelor of Business Administration',
    org: 'University of Tikrit',
    period: 'Aug 2026',
  },
];

const certifications = [
  {
    title: 'Software Engineer Certification',
    org: 'HackerRank',
    period: 'Mar 2025',
    url: 'https://www.hackerrank.com/certificates/82d47e7b38f5',
  },
  {
    title: 'JavaScript Algorithms and Data Structures',
    org: 'freeCodeCamp',
    period: 'Mar 2025',
    url: 'https://freecodecamp.org/certification/fcc3c73bf9b-a6f3-4c4b-b4e0-173354fc95ad/javascript-algorithms-and-data-structures-v8',
  },
];
---

<BaseLayout title="About" description={`About ${SITE.name} · ${SITE.role}`}>
  <div class="mx-auto max-w-[680px] px-6 py-16">
    <h1 class="text-3xl font-semibold tracking-tight">About</h1>
    <div class="mt-8 space-y-5 text-[1.0625rem] leading-relaxed text-[var(--color-muted)]">
      <p>{SITE.bio}</p>
      {SITE.bioExtended.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <div class="mt-8 flex flex-wrap gap-4">
      <a
        href={SITE.cv}
        target="_blank"
        rel="noopener noreferrer"
        class="border border-[var(--color-ink)] px-5 py-2.5 text-sm font-medium transition-colors hover:bg-[var(--color-ink)] hover:text-[var(--color-surface)]"
      >
        Preview CV
      </a>
      <a
        href={SITE.cv}
        download="Mohammed-Sinan-CV.pdf"
        class="border border-[var(--color-border)] px-5 py-2.5 text-sm text-[var(--color-muted)] transition-colors hover:border-[var(--color-ink)] hover:text-[var(--color-ink)]"
      >
        Download CV
      </a>
    </div>

    <section class="mt-16">
      <h2 class="text-sm font-medium uppercase tracking-wider text-[var(--color-muted)]">
        Experience
      </h2>
      <div class="mt-6 space-y-8">
        {
          experience.map((job) => (
            <div class="border-b border-[var(--color-border)] pb-8 last:border-b-0">
              <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                <h3 class="font-medium">{job.title}</h3>
                <span class="text-sm text-[var(--color-muted)]">{job.period}</span>
              </div>
              <p class="mt-1 text-sm text-[var(--color-muted)]">{job.company}</p>
              <p class="mt-3 text-sm leading-relaxed text-[var(--color-muted)]">{job.summary}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-16">
      <h2 class="text-sm font-medium uppercase tracking-wider text-[var(--color-muted)]">
        Skills
      </h2>
      <div class="mt-6 grid gap-8 sm:grid-cols-2">
        {
          Object.entries(skills).map(([category, items]) => (
            <div>
              <h3 class="text-sm font-medium">{category}</h3>
              <ul class="mt-3 flex flex-wrap gap-2">
                {items.map((skill) => (
                  <li class="rounded-full border border-[var(--color-border)] px-2.5 py-0.5 text-xs text-[var(--color-muted)]">
                    {skill}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-16">
      <h2 class="text-sm font-medium uppercase tracking-wider text-[var(--color-muted)]">
        Education
      </h2>
      <div class="mt-6 space-y-6">
        {
          education.map((item) => (
            <div class="border-b border-[var(--color-border)] pb-6 last:border-b-0">
              <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                <h3 class="font-medium">{item.title}</h3>
                <span class="text-sm text-[var(--color-muted)]">{item.period}</span>
              </div>
              <p class="mt-1 text-sm text-[var(--color-muted)]">{item.org}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-16">
      <h2 class="text-sm font-medium uppercase tracking-wider text-[var(--color-muted)]">
        Certifications
      </h2>
      <div class="mt-6 space-y-6">
        {
          certifications.map((item) => (
            <div class="border-b border-[var(--color-border)] pb-6 last:border-b-0">
              <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                <h3 class="font-medium">
                  <a
                    href={item.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline-offset-4 hover:underline"
                  >
                    {item.title} ↗
                  </a>
                </h3>
                <span class="text-sm text-[var(--color-muted)]">{item.period}</span>
              </div>
              <p class="mt-1 text-sm text-[var(--color-muted)]">{item.org}</p>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
