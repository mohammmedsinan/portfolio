---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

const skills = {
  Backend: [
    'Node.js',
    'NestJS',
    'Sails.js',
    'TypeScript',
    'REST APIs',
    'TypeORM',
    'MySQL',
    'PostgreSQL',
    'Redis',
    'AI/LLM Pipelines',
  ],
  Frontend: [
    'React',
    'Vite',
    'TanStack Router/Query',
    'Tailwind CSS',
    'Radix UI',
    'PWA',
    'i18n / RTL',
  ],
  'Cloud & DevOps': [
    'Docker',
    'PM2',
    'DigitalOcean',
    'Firebase Hosting',
    'CI/CD',
    'GCS',
  ],
  'Architecture & Delivery': [
    'System Architecture',
    'Code Review',
    'Stakeholder Delivery',
    'Release Management',
  ],
};

const experience = [
  {
    title: 'Senior Full Stack Developer',
    company: 'Optimiza Digital INC · Koora Kings',
    period: 'Dec 2023 – Present',
    summary:
      'Core contributor across backend API, admin dashboard, and production infrastructure for a fantasy sports platform.',
  },
  {
    title: 'Senior Full Stack Developer',
    company: 'LocalEyes / Optimiza.dev',
    period: 'Apr 2025 – Present',
    summary:
      'Primary contributor on NestJS AI backend module and React 19 production dashboard for a B2B local SEO SaaS platform.',
  },
  {
    title: 'Senior Full Stack Developer',
    company: 'Large-Scale Events Platform',
    period: 'Contract',
    summary:
      'Architected and delivered a high-traffic events platform across the full stack.',
  },
  {
    title: 'Senior Full Stack Developer',
    company: 'Enterprise Dashboard & Website',
    period: 'Contract',
    summary:
      'Delivered complete dashboard and public website ecosystem for a private company.',
  },
];
---

<BaseLayout title="About" description={`About ${SITE.name} · ${SITE.role}`}>
  <div class="mx-auto max-w-[680px] px-6 py-16">
    <h1 class="text-3xl font-semibold tracking-tight">About</h1>
    <div class="mt-8 space-y-5 text-[1.0625rem] leading-relaxed text-[var(--color-muted)]">
      <p>{SITE.bio}</p>
      {SITE.bioExtended.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <section class="mt-16">
      <h2 class="text-sm font-medium uppercase tracking-wider text-[var(--color-muted)]">
        Experience
      </h2>
      <div class="mt-6 space-y-8">
        {
          experience.map((job) => (
            <div class="border-b border-[var(--color-border)] pb-8 last:border-b-0">
              <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                <h3 class="font-medium">{job.title}</h3>
                <span class="text-sm text-[var(--color-muted)]">{job.period}</span>
              </div>
              <p class="mt-1 text-sm text-[var(--color-muted)]">{job.company}</p>
              <p class="mt-3 text-sm leading-relaxed text-[var(--color-muted)]">{job.summary}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-16">
      <h2 class="text-sm font-medium uppercase tracking-wider text-[var(--color-muted)]">
        Skills
      </h2>
      <div class="mt-6 grid gap-8 sm:grid-cols-2">
        {
          Object.entries(skills).map(([category, items]) => (
            <div>
              <h3 class="text-sm font-medium">{category}</h3>
              <ul class="mt-3 flex flex-wrap gap-2">
                {items.map((skill) => (
                  <li class="rounded-full border border-[var(--color-border)] px-2.5 py-0.5 text-xs text-[var(--color-muted)]">
                    {skill}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
