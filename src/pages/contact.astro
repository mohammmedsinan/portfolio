---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
---

<BaseLayout title="Contact" description={`Contact ${SITE.name}`}>
  <div class="mx-auto max-w-[680px] px-6 py-16">
    <h1 class="text-3xl font-semibold tracking-tight">Contact</h1>
    <p class="mt-6 text-lg leading-relaxed text-[var(--color-muted)]">
      I'm open to full-stack roles and interesting product collaborations. The
      best way to reach me is by email or phone.
    </p>

    <div class="mt-12 space-y-6">
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="min-w-0 border border-[var(--color-border)] p-6">
          <p class="text-xs uppercase tracking-wider text-[var(--color-muted)]">Email</p>
          <a
            href={`mailto:${SITE.email}`}
            class="mt-2 block break-all text-base font-medium transition-opacity hover:opacity-70 sm:text-lg"
          >
            {SITE.email}
          </a>
        </div>
        <div class="min-w-0 border border-[var(--color-border)] p-6">
          <p class="text-xs uppercase tracking-wider text-[var(--color-muted)]">Phone</p>
          <a
            href={`tel:${SITE.phone.replace(/[\s()-]/g, '')}`}
            class="mt-2 block break-words text-base font-medium transition-opacity hover:opacity-70 sm:text-lg"
          >
            {SITE.phone}
          </a>
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <a
          href={SITE.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="border border-[var(--color-border)] p-6 transition-colors hover:border-[var(--color-ink)]"
        >
          <p class="text-xs uppercase tracking-wider text-[var(--color-muted)]">LinkedIn</p>
          <p class="mt-2 font-medium">Connect on LinkedIn →</p>
        </a>
        <a
          href={SITE.github}
          target="_blank"
          rel="noopener noreferrer"
          class="border border-[var(--color-border)] p-6 transition-colors hover:border-[var(--color-ink)]"
        >
          <p class="text-xs uppercase tracking-wider text-[var(--color-muted)]">GitHub</p>
          <p class="mt-2 font-medium">View projects on GitHub →</p>
        </a>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <a
          href={SITE.cv}
          target="_blank"
          rel="noopener noreferrer"
          class="border border-[var(--color-border)] p-6 transition-colors hover:border-[var(--color-ink)]"
        >
          <p class="text-xs uppercase tracking-wider text-[var(--color-muted)]">CV</p>
          <p class="mt-2 font-medium">Preview CV →</p>
        </a>
        <a
          href={SITE.cv}
          download="Mohammed-Sinan-CV.pdf"
          class="border border-[var(--color-border)] p-6 transition-colors hover:border-[var(--color-ink)]"
        >
          <p class="text-xs uppercase tracking-wider text-[var(--color-muted)]">CV</p>
          <p class="mt-2 font-medium">Download CV ↓</p>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
