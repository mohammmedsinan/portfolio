---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
---

<BaseLayout
  title="Projects"
  description="Selected projects: local SEO SaaS, fantasy sports, events platforms, and React dashboards."
>
  <div class="mx-auto max-w-[960px] px-6 py-16">
    <h1 class="text-3xl font-semibold tracking-tight">Projects</h1>
    <p class="mt-4 max-w-[680px] text-lg leading-relaxed text-[var(--color-muted)]">
      Production work across local SEO SaaS, fantasy sports, events platforms, and React
      dashboard architecture — plus live products I've shipped.
    </p>
    <div class="mt-12 grid gap-4 sm:grid-cols-2">
      {projects.map((project) => <ProjectCard project={project} featured />)}
    </div>
  </div>
</BaseLayout>
