---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
---

<a
  href={`/projects/${project.slug}`}
  class="group block border border-[var(--color-border)] p-6 transition-colors hover:border-[var(--color-ink)]"
>
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-xs uppercase tracking-wider text-[var(--color-muted)]">
        {project.company}
      </p>
      <h3 class="mt-1 text-lg font-medium tracking-tight group-hover:underline">
        {project.title}
      </h3>
    </div>
    {
      featured && (
        <span class="shrink-0 text-xs text-[var(--color-muted)]">{project.period}</span>
      )
    }
  </div>
  <p class="mt-3 text-sm leading-relaxed text-[var(--color-muted)]">
    {project.summary}
  </p>
  {
    project.metrics.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1">
        {project.metrics.slice(0, 3).map((metric) => (
          <li class="text-xs text-[var(--color-muted)]">{metric}</li>
        ))}
      </ul>
    )
  }
</a>
