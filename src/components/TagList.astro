---
interface Props {
  tags: string[];
  linked?: boolean;
}

const { tags, linked = false } = Astro.props;
---

<div class="flex flex-wrap gap-2">
  {
    tags.map((tag) =>
      linked ? (
        <a
          href={`/blog/tag/${tag}`}
          class="rounded-full border border-[var(--color-border)] px-2.5 py-0.5 text-xs text-[var(--color-muted)] transition-colors hover:border-[var(--color-ink)] hover:text-[var(--color-ink)]"
        >
          {tag}
        </a>
      ) : (
        <span class="rounded-full border border-[var(--color-border)] px-2.5 py-0.5 text-xs text-[var(--color-muted)]">
          {tag}
        </span>
      ),
    )
  }
</div>
